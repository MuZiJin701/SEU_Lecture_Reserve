# Copy to .env, fill in credentials, then run: uv run main.py
# The application loads this project-root file automatically.
# Never commit your real .env.
# Existing process environment variables take precedence over this file.
SEU_CARD_NUMBER=
SEU_PASSWORD=

# VPN backup IP verified on 2026-10-16; update if the university changes its address.
# Normal DNS is always tried first. Clear this value to disable backup IP recovery.
# Only an eligible initial-login network failure can restart Chrome once with this IP.
# Authentication may still fail; does not change system DNS/Clash or recover running reservations.
SEU_VPN_IP=121.249.14.2

# Lists use JSON arrays enclosed in single quotes for dotenv syntax.
# Exact titles still obey category/campus/online/conflict filters.
SEU_PREFERRED_LECTURES='[]'
SEU_REQUIRED_CATEGORIES='["人文与科学素养系列讲座_心理健康","人文与科学素养系列讲座_法律","人文与科学素养系列讲座-艺术类","人文与科学素养系列讲座_其他"]'
# Empty means no offline campus matches. Example: '["无锡校区"]'
SEU_PREFERRED_CAMPUS='[]'

# Booleans: true or false.
SEU_ENABLE_OFFLINE=true
SEU_ENABLE_ONLINE=true

# Finite, non-negative seconds. Scan interval must be greater than zero.
# Playwright element/redirect waits convert zero to 1 ms (never unlimited).
SEU_TIMEOUT_PAGE_LOAD=0.5
# Default timeout for navigation, element actions, and reservation confirmation.
SEU_TIMEOUT_ELEMENT_WAIT=3
# Maximum authentication redirect wait; unsupported challenges stop the task.
SEU_TIMEOUT_LOGIN_REDIRECT=30
SEU_TIMEOUT_SCAN_INTERVAL=10
# Initial delay, then element_wait bounds target reservation-state confirmation.
SEU_TIMEOUT_ACTION_CONFIRM=0.2

# Browser mode is selected only on the command line: default headed; --headless for no window.

# Private checkpoint and event directory (relative to the project root).
SEU_STATE_DIR=state

# Optional email: leave unset to disable. Gmail needs only these two values.
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-app-password
# Advanced SMTP overrides (TLS): SMTP_HOST, SMTP_PORT, MAIL_FROM, MAIL_TO.
