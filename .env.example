# 首次使用：复制为项目根目录的 .env，填写账号后先运行 uv run main.py --check。
# 已有 .env 请手动合并需要调整的项，不要直接覆盖；修改后重启程序。
# 程序自动加载 .env，已有进程环境变量优先；真实 .env 不得提交。
SEU_CARD_NUMBER=
SEU_PASSWORD=

# VPN 备用地址曾于 2026-10-16 验证；学校地址变化后需更新，清空则关闭回退。
# 首次登录优先使用正常 DNS，仅符合条件的 VPN 主框架网络失败才以备用地址重启一次。
# 可能再次需要短信认证；不修改系统 DNS 或 Clash，不恢复业务阶段的网络故障。
SEU_VPN_IP=121.249.14.2

# 列表使用单引号包裹的 JSON 数组；空标题列表表示不限制标题。
# 完整标题仍须满足类别、校区、线上线下及时间冲突条件。
SEU_PREFERRED_LECTURES='[]'
SEU_REQUIRED_CATEGORIES='["人文与科学素养系列讲座_心理健康","人文与科学素养系列讲座_法律","人文与科学素养系列讲座-艺术类","人文与科学素养系列讲座_其他"]'
# 空校区列表不匹配任何线下讲座；需要线下时填学校中的名称，例如 '["无锡校区"]'。
SEU_PREFERRED_CAMPUS='[]'

# 开关仅接受 true 或 false；当前校区为空，因此默认只匹配线上讲座。
SEU_ENABLE_OFFLINE=true
SEU_ENABLE_ONLINE=true

# 时间单位均为秒，须为有限非负数，扫描间隔必须大于零。
# 页面与认证等待适当放宽以适应慢网络；不能修复断线、白屏或认证受阻。
# Playwright 超时填零会转换为 1 毫秒，不代表无限等待。
# 登录导航后的额外等待，不代替页面和数据就绪检查。
SEU_TIMEOUT_PAGE_LOAD=0.5
# 页面导航、数据加载、元素操作和预约结果显示的等待上限。
SEU_TIMEOUT_ELEMENT_WAIT=15
# 认证跳转的等待上限；程序不提供短信输入，无法完成认证时停止。
SEU_TIMEOUT_LOGIN_REDIRECT=60
# 正常扫描及预约结果待确认时的查询间隔；连续失败会自动延长重试间隔。
SEU_TIMEOUT_SCAN_INTERVAL=10
# 提交后的基础等待，之后仍须按活动 ID 核对，等待上限由元素等待控制。
SEU_TIMEOUT_ACTION_CONFIRM=0.2

# 浏览器模式只由命令行选择：默认显示窗口，添加 --headless 使用无头模式。

# 私有检查点和事件日志目录，相对于项目根目录；恢复任务时保留此目录。
SEU_STATE_DIR=state

# 邮件可选：只配置一个发件账号，默认发给自己；收件邮箱可来自其他服务商。
# 不需要邮件时，除 SMTP_PORT 可保留 465 外，其余邮件字段全部留空。
# SMTP_USERNAME：完整发件邮箱地址；QQ、163、126、Gmail 只需填写账号和下方密码。
# 例如：your-address@qq.com / your-address@163.com / your-address@126.com / your-address@gmail.com。
SMTP_USERNAME=
# SMTP_PASSWORD：QQ、163、126 填开启 SMTP 后生成的客户端授权码；不要填网页登录密码。
# Gmail 填开启两步验证后生成的 16 字符应用专用密码，去掉分组空格。
# Gmail 创建入口：https://myaccount.google.com/apppasswords；修改 Google 登录密码后需重新生成。
# 建议用单引号包裹，例如 SMTP_PASSWORD='your-authorization-code'，不要填写此示例文字。
# 各邮箱开启服务、获取授权码和完整填写教程见 README.md / README.en.md 第 2 节。
SMTP_PASSWORD=
# SMTP_HOST：以下发件地址域名自动匹配主机（不区分大小写），可留空：
# qq.com -> smtp.qq.com；163.com -> smtp.163.com；126.com -> smtp.126.com；gmail.com -> smtp.gmail.com。
# 显式填写时优先使用此值；其他域名、别名和自建邮箱须按服务商要求填写，例如 smtp.example.org。
# 这里只填主机名，不带 https://、端口或路径；更换发件邮箱时，清空不再适用的显式主机。
SMTP_HOST=
# SMTP_PORT：SMTP_SSL 端口，上述四家均使用 465，通常保持默认即可。
# 仅支持建立连接即使用 TLS，并校验证书；不支持 587 STARTTLS 或明文 SMTP。
# Outlook.com 等要求 STARTTLS/OAuth 的服务不属于本模板的简化配置范围。
SMTP_PORT=465
# MAIL_FROM：实际发件地址，留空使用 SMTP_USERNAME；一般留空，覆盖须获服务商允许。
MAIL_FROM=
# MAIL_TO：单个收件地址，留空使用 MAIL_FROM（MAIL_FROM 也为空时即发给自己）。
# 可以跨服务商，例如 QQ 发件、Gmail 收信；不要填写多个地址或收件人显示名称。
MAIL_TO=
# 保存后先运行 uv run main.py --test-mail，并确认收件箱收到，再恢复预约。
# 网页能访问不代表 SMTP 可用；校园网、热点和 Clash 路径应分别验证，不自动切换网络或邮箱。
# 发信失败时查看终端 reason 错误码或 --status 中的 last_mail_error，不需要打印凭据或原始异常。
# 运行期间自动发送重要通知和每日北京时间 20:00 的进度汇报，发信失败不自动重发。
