# 首次复制为根目录 .env；已有文件只合并需要的项，保留凭据，修改后重启。
# 环境变量优先；真实 .env 不提交。填写后先运行 uv run main.py --check。
SEU_CARD_NUMBER=
SEU_PASSWORD=

# 首次登录正常 DNS 优先，符合条件的 VPN 网络故障才用备用 IP 重启一次。
# 2026-10-16 历史地址，失效时更新或清空；可能再次需要认证，不改系统 DNS／代理。
SEU_VPN_IP=121.249.14.2

# 列表为单引号包裹的 JSON 数组；空标题列表不限制，其他筛选仍生效。
SEU_PREFERRED_LECTURES='[]'
SEU_REQUIRED_CATEGORIES='["人文与科学素养系列讲座_心理健康","人文与科学素养系列讲座_法律","人文与科学素养系列讲座-艺术类","人文与科学素养系列讲座_其他"]'
# 空校区不约线下；需要时填学校名称，例如 '["无锡校区"]'。
SEU_PREFERRED_CAMPUS='[]'
# 开关只用 true / false；当前校区为空，因此默认只约线上。
SEU_ENABLE_OFFLINE=true
SEU_ENABLE_ONLINE=true

# 以下时间单位为秒，须有限且非负，扫描间隔须大于零。
# Playwright 超时为零转为 1 毫秒；放宽等待不能修复断线或认证受阻。
# 登录导航后的额外等待。
SEU_TIMEOUT_PAGE_LOAD=0.5
# 页面、数据、元素和结果显示上限；内置 3 秒，模板放宽至 15 秒。
SEU_TIMEOUT_ELEMENT_WAIT=15
# 认证跳转上限；内置 30 秒，模板 60 秒，不提供短信输入。
SEU_TIMEOUT_LOGIN_REDIRECT=60
# 正常扫描和待确认查询间隔；连续失败自动延长等待。
SEU_TIMEOUT_SCAN_INTERVAL=10
# 提交后基础等待，之后仍按活动 ID 核对。
SEU_TIMEOUT_ACTION_CONFIRM=0.2

# 默认显示浏览器窗口，命令加 --headless 隐藏；状态目录相对项目根目录。
# 目录保存私有检查点和事件，恢复时保留。
SEU_STATE_DIR=state

# 邮件可选；关闭时除 SMTP_PORT 可保留 465 外，其余邮件项全部留空。
# 获取密码与排错见 docs/usage.md「邮件配置」或 docs/usage.en.md「Email setup」。
# 完整发件地址；QQ／163／126／Gmail 自动匹配主机，一次用一个账号。
SMTP_USERNAME=
# QQ／163／126 填 SMTP 授权码；Gmail 填两步验证后的 16 字符应用专用密码。
# 去掉 Gmail 分组空格；不用网页登录密码，建议用单引号包裹。
SMTP_PASSWORD=
# 留空按上述域名识别；显式值优先，其他域名须填写服务商主机名。
# 不含 URL、端口或路径；切换邮箱时清空或更新旧主机。
SMTP_HOST=
# SMTP_SSL 端口，通常保持 465；校验证书，不支持 587 STARTTLS、明文或 OAuth。
SMTP_PORT=465
# 发件地址默认 SMTP_USERNAME；通常留空，覆盖须获服务商允许。
MAIL_FROM=
# 单个收件地址，默认 MAIL_FROM，再默认发给自己；可填其他服务商邮箱。
MAIL_TO=
# 保存后停止旧实例，uv run main.py --test-mail，并确认收件箱收到再恢复预约。
# 运行期间发送重要通知和每天北京时间 20:00 汇报；失败不自动重发。
# SMTP 不自动使用 HTTP 代理变量；排错看终端 reason 或 --status 的 last_mail_error。
